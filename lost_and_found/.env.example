# ─────────────────────────────────────────────────────────────
#  SmartFind backend — environment variables
#  Copy this file to `.env` and fill in the values.
#  NEVER commit `.env` (it is in .gitignore).
# ─────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Neon connection string. Must include `sslmode=require`.
# Example: postgresql://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Maximum database connections (Neon free tier: keep it small).
DB_POOL_MAX=10

# Signs access/refresh tokens. Also used to derive the OTP hashing and encryption keys.
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Key for HMAC-SHA256 of national IDs. MUST differ from JWT_SECRET.
# Changing it later means re-creating every university_students row.
NID_HMAC_KEY=replace-with-a-different-32-character-secret

# Comma-separated list of web origins allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Gemini ────────────────────────────────────────────────────
# Keys are tried in numeric order, one attempt each. Leave unused slots empty.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GEMINI_API_KEY6=
GEMINI_API_KEY7=
GEMINI_API_KEY8=
GEMINI_API_KEY9=
GEMINI_API_KEY10=

# Time limit for ONE call to Gemini (milliseconds).
AI_TIMEOUT_MS=60000

# Time limit for a WHOLE AI step, across every key and fallback model.
# When it runs out, the report is kept as a draft ("Waiting for AI").
AI_STEP_DEADLINE_MS=45000

# Models. Each one may be a comma-separated FALLBACK LIST:
# model 1 is tried on every key first, then model 2 on every key, and so on.
GEMINI_MODEL_FOLLOWUPS=gemini-3.1-flash-lite
GEMINI_MODEL_EXTRACTION=gemini-3.1-flash-lite
GEMINI_MODEL_QUESTIONS=gemini-2.5-pro

# Embedding model: exactly ONE model (vectors from different models are never compared).
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# ── First admin account (created by `npm run seed`) ───────────
ADMIN_STUDENT_ID=ADMIN001
ADMIN_EMAIL=admin@smartfind.local
ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────
# Timezone used to decide "today" for dates and daily limits.
APP_TIMEZONE=Asia/Dhaka

# The ESP32 polls once per second; those lines are hidden unless this is true.
LOG_DEVICE_POLLS=false

# Swagger UI at http://localhost:4000/api/docs (raw spec: /api/docs/openapi.json).
# Set to false to hide it.
API_DOCS_ENABLED=true

# Secret for the demo device KIOSK-01 created by `npm run seed`.
# Leave empty and the seed prints a freshly generated one.
DEVICE_SEED_SECRET=
